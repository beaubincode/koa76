// KOA 76: one Worker serves the website from ./public and handles POST /api/contact.
// Before the first deploy, replace every value marked REPLACE (see README.md, "Configure").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koa76",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // The static site. Files are served directly; requests that match no file reach src/index.js.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },

  // Serve the site on your domain. Uncomment after the domain is on Cloudflare (README, step 4).
  // "routes": [
  //   { "pattern": "REPLACE-your-domain.com", "custom_domain": true },
  //   { "pattern": "www.REPLACE-your-domain.com", "custom_domain": true }
  // ],

  // Cloudflare Email Service (Email Sending).
  "send_email": [
    // Inquiry notifications. Locked to your inbox, so this binding can never email anyone else.
    { "name": "NOTIFY_EMAIL", "destination_address": "REPLACE-inbox@your-domain.com" },
    // Optional acknowledgment to the visitor (SEND_ACKNOWLEDGMENT = "true"). Locked to your sender address.
    // Sending to visitors (arbitrary recipients) needs the Workers Paid plan.
    { "name": "REPLY_EMAIL", "allowed_sender_addresses": ["REPLACE-hello@your-domain.com"] }
  ],

  // Workers Rate Limiting: 3 submissions per minute per IP, and per email address, in each Cloudflare location.
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "7601", "simple": { "limit": 3, "period": 60 } }
  ],

  // Not secret. The Turnstile secret key is a secret: set it with `npx wrangler secret put TURNSTILE_SECRET_KEY`.
  "vars": {
    // Must be an address on the domain you onboarded in Email Service > Email Sending.
    "SENDER_EMAIL": "REPLACE-hello@your-domain.com",
    "SENDER_NAME": "KOA 76 Website",
    // Where inquiries arrive. Must match NOTIFY_EMAIL's destination_address above.
    "INBOX_EMAIL": "REPLACE-inbox@your-domain.com",
    // Sites allowed to post to the API, comma separated. The Worker's own address is always allowed.
    "ALLOWED_ORIGINS": "https://REPLACE-your-domain.com,https://www.REPLACE-your-domain.com",
    "SEND_ACKNOWLEDGMENT": "false",
    "BRAND_TAGLINE": "Different by Design.",
    "TIMEZONE": "America/Chicago"
  },

  "observability": { "enabled": true }
}
